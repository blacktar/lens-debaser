LensDebaserPreset=2
# Family: Demo-Capture
# Strength: Educational
# Adds peripheral detail loss, field curvature, longitudinal focus color and natural vignetting, then lets the Capture settings coordinate their strength.
captureAperture=1.6
captureFocalLength=24
captureFocusDistance=90
captureGate=1
captureInfluence=0.8
cornerSharpnessLoss=0.68
fieldCurvature=0.46
longitudinalCA=0.28
vignetteNatural=0.22
